# Add INSIDE the existing HTTPS server block after checking nginx -T.
# Keep its server_name, listen and ssl_* directives unchanged.
# Paths below are proposed NEW locations; confirm they are unused first.
location = /learning-preview { return 301 /learning-preview/; }
location /learning-preview/ {
    alias /var/www/spds-learning-preview/;
    index index.htm;
    auth_basic "SPDS preview";
    auth_basic_user_file /etc/spds-learning/admin.htpasswd;
    add_header Cache-Control "no-store";
}
location = /learning-test-api/complete {
    auth_basic "SPDS preview";
    auth_basic_user_file /etc/spds-learning/admin.htpasswd;
    client_max_body_size 512;
    access_log off;
    proxy_pass http://127.0.0.1:8766/complete;
}
location = /learning-test-api/totals {
    auth_basic "SPDS totals";
    auth_basic_user_file /etc/spds-learning/admin.htpasswd;
    access_log off;
    proxy_pass http://127.0.0.1:8766/totals;
}
location = /learning-api/complete {
    client_max_body_size 512;
    access_log off;
    proxy_pass http://127.0.0.1:8765/complete;
}
location = /learning-api/totals {
    auth_basic "SPDS totals";
    auth_basic_user_file /etc/spds-learning/admin.htpasswd;
    access_log off;
    proxy_pass http://127.0.0.1:8765/totals;
}
# Never proxy an entire API prefix to the backend: /totals must stay protected.
